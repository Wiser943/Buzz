PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/buzzer
JWT_SECRET=replace_with_a_long_random_secret

# ImgBB image hosting (get a key at https://api.imgbb.com). Images upload there when set.
IMGBB_API_KEY=

# Comma-separated emails that become admins on signup / server start
ADMIN_EMAILS=

# Payments (Paystack): create a key at https://dashboard.paystack.com ; add webhook URL https://YOUR-APP/api/payments/webhook
PAYSTACK_SECRET_KEY=
APP_URL=https://your-app.onrender.com
# Google AdSense (optional): shows Google ads in the feed
ADSENSE_CLIENT=
ADSENSE_SLOT=
# Moderation: comma-separated words that are rejected outright; reports needed to auto-hide a post/track
BANNED_WORDS=
AUTO_HIDE_REPORTS=3
# Persistent disk path for audio/video uploads (Render disk), e.g. /var/data/uploads
UPLOAD_DIR=

# ---- Stage 17-19 ----
# Email (password reset + email verification). Use ONE provider. Brevo free plan: https://www.brevo.com (verify a sender email there)
BREVO_API_KEY=
# or Resend: https://resend.com (needs a verified domain to email other people)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Buzzer
# Shown in Settings > Help and support
SUPPORT_EMAIL=

# Buzzer AI assistant (Google AI Studio key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Model names change often. Comma-separated, tried in order if one is not found.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash
# Messages per user per day (the free Gemini tier has small limits)
AI_DAILY_LIMIT=20

# Automatic fixtures and scores for Predictions (football-data.org free key: https://www.football-data.org)
FOOTBALL_DATA_API_KEY=
# Optional competition codes, e.g. PL,CL,PD,SA,BL1,FL1,WC
FOOTBALL_COMPETITIONS=

# Game points a user can earn per day
GAME_DAILY_CAP=15
