PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/buzzer
JWT_SECRET=replace_with_a_long_random_secret

# ImgBB image hosting (get a key at https://api.imgbb.com). Images upload there when set.
IMGBB_API_KEY=

# Comma-separated emails that become admins on signup / server start
ADMIN_EMAILS=

# Payments (Paystack): create a key at https://dashboard.paystack.com ; add webhook URL https://YOUR-APP/api/payments/webhook
PAYSTACK_SECRET_KEY=
APP_URL=https://your-app.onrender.com
# Google AdSense (optional): shows Google ads in the feed
ADSENSE_CLIENT=
ADSENSE_SLOT=
# Moderation: comma-separated words that are rejected outright; reports needed to auto-hide a post/track
BANNED_WORDS=
AUTO_HIDE_REPORTS=3
# Persistent disk path for audio/video uploads (Render disk), e.g. /var/data/uploads
UPLOAD_DIR=
